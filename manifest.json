{
  "manifest_version": 3,
  "name": "Page Translator 一键翻译",
  "version": "0.1.0",
  "description": "点一下，把当前网页的文章翻译成中文并与原文对照显示。默认使用 DeepSeek API。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://api.deepseek.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "翻译已关闭 · 点击开启（Alt+T）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "src/options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+T" },
      "description": "翻译当前页面 / 切换原文"
    }
  }
}
